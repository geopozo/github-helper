# get members in org, members in each team, permission of team, etc
# sets globals: org, repo, org_type, select
org_info() {
  IFS="/" read -r org repo <<< "$1"
  if [[ -n "$repo" ]]; then
    org_type="repo"
    select=".[] | select(.name==\"$repo\") "
  else
    select="sort_by(.isPrivate, .isArchived)[] "
    org_type="$(gh api /users/$org --jq '.type' | tr '[:upper:]' '[:lower:]')"
    if [[ "$org_type" == "organization" ]]; then
      basic_perms="$(gh api /orgs/geopozo --jq '"members have \(.default_repository_permission)\(if .members_can_create_repositories==true then "& create" else "" end) \(if .two_factor_requirement_enabled==true then "" else "but NO 2FA" end)"')"
      outsiders="$(gh api /orgs/$org/outside_collaborators --jq '.[] | .login')"
      org_invites="$(gh api /orgs/$org/invitations --jq '.[] | .login')"
      teams="$(gh api /orgs/$org/teams --jq '.[] | "\(.slug)\t\(.permission)"')"
      gh api orgs/$org/teams/$team_slug/members .login
      gh api orgs/$org/teams/$team_slug/projects .name .permissions
      gh api orgs/$org/teams/$team_slug/repositories .name .permissions

      # /org/NAME/rulesets[/rule-suites]? TODO what is it
    fi
  fi
  select="$select"' | "\(.name) \(.visibility) \(.isArchived) \(.description)"'
}

red="$(tput setaf 1)"
white="$(tput setaf 7)"
color()
{
  echo -en $1
}

for identifier in "${SOLO[@]}"; do
  echo "$identifier"

  org=""
  repo=""
  select=""
  org_type=""
  org_info $identifier

  public=""
  while read -r name vis archive desc; do
    if [[ "$AUDIT" == "false" ]] && [[ "$vis" == "PRIVATE" ]] && [[ -z "$repo" ]]; then
      continue # specific to SOLO, add conditional
    fi

    if [[ "$archive" == "true" ]]; then
      color $red
    else
      color $white
    fi

    # Print
    collabs="????"
    if [[ "$AUDIT" == "true" ]]; then
      collabs="$(echo $(gh api /repos/$org/$name/collaborators --jq '.[].login'))"
    fi

    # Print Headers
    if [[ "$public" != "false" ]] && [[ "$vis" == "PRIVATE" ]]; then
      public=false
      printf " private\t\t\t\t\n"
    elif [[ "$public" != "true" ]] && [[ "$vis" == "PUBLIC" ]]; then
      public=true
      printf " public\t\t\t\t\n"
    fi

    status="$(gh api /repos/$org/$name --jq '"\(.open_issues) 🚨  \(.forks) 🍴  \(.watchers) 👀  \(.stargazers_count) 🌟"')"
    printf "\t%s\t%s\t%s\t%s\n" "$name" "$desc" "$collabs" "$status"

    color $white
    # for single user .isPrivate, .isArchived since if private nothing else really matters, set non-archived first, since private is still active
  done< <(gh repo list $org -L 300 --json name,isPrivate,isArchived,visibility --jq "$select") | column -t -s $'\t' # api has language and default branch
done
