#!/bin/bash

gh auth status | grep -q "Logged in" || { echo "Not logged in" && exit 1; }

set -e
set -u

FLAGS=("--audit")
ARGFLAGS=("--collab" "--solo" "--activity")

usage=(
  "hub status is to help you keep track of all your github repos. It will"
  "show you information such as: active teams, what they have access to,"
  "which repositories are pinned, activity over time period of repository"
  "or its issues etc. It checks to make sure basic rules are set-up, etc."
  ""
  "Usage (DO NOT USE --long-flags=something, just --long-flag something):"
  "You can always try -v or --verbose, maybe no change."
  ""
  "hub [-h|--h]: display this help"
  ""
  "hub [--audit]: will show collaborators for all non-archived repositories"
  ""
  "hub [--collab] ORG/REPO,ORG: A comma seperated list of repos that are analyzed"
  "                             assuming that other people are collaborating."
  ""
  "hub [--solo] ORG/REPO,ORG: A comma seperated list of repos that are analyzed"
  "                             assuming that you are the only writer."
  ""
  "hub [--activity] ORG/REPO,ORG: A comma seperated list of repos that are analyzed"
  "                             assuming that you have only read access."
  ""
  "Examples:"
  ""
  "hub --solo ayjayt shows only public since we assume no one has read to private"
  "hub --audit --solo ayjayt shows everything w/ access to check who has access,"
  "                          but it doesn't bother checking archived"
)

util_error()
{
    echo -e "Error: $@" >&2
    exit 1
}

if [[ -z "${usage-}" ]]; then
  util_error "The script author must create a \`usage\` string-array prior to calling utilities.sh or flags.sh"
fi

if [[ ! "$(declare -p FLAGS)" =~ "declare -a" ]] || [[ ! "$(declare -p ARGFLAGS)" =~ "declare -a" ]]; then
  util_error "The script author must at least declare a FLAGS and ARGFLAGS array. FLAGS=(); ARGFLAGS=();"
fi

declare -A ARGS
NO_VERBOSE=true
while (( $# )); do
  case $1 in
    -h|--help)      printf "%s\n" "${usage[@]}"; exit 0  ;;
    -v|--verbose)   NO_VERBOSE=false                     ;;
    *)
      if [[ "${1}" == -* ]]; then
        if [[ " ${FLAGS[*]} " =~ " ${1} " ]]; then
          ARGS["${1}"]=true
        elif [[ " ${ARGFLAGS[*]} " =~ " ${1} " ]]; then
          KEY="${1}"; shift
          ARGS["$KEY"]="${1}"
        elif [[ "${1}" == "--" ]]; then
          shift
          ARGS[":"]="${@}"
          break 1
        else
          util_error "Unknown flag: \"${1}\". See --help."
        fi
      elif [[ " ${FLAGS[*]} " =~ " : " ]]; then
        ARGS[":"]="${@}"
        break 1
      else
        util_error "Unknown argument: ${1}. See --help" || true
      fi
      ;;
  esac
  shift
done

flags_resolve()
{
  DEFAULT="$1"
  shift
  while (( $# )); do
    [[ -v ARGS["$1"] ]] && echo "${ARGS[$1]}" && return || true
    shift
  done
  echo "$DEFAULT"
}


AUDIT="$(flags_resolve false "--audit")"
IFS="," read -a COLLAB <<< "$(flags_resolve "" "--collab")"
IFS="," read -a SOLO <<< "$(flags_resolve "" "--solo")"
IFS="," read -a ACTIVITY <<< "$(flags_resolve "" "--activity")"

